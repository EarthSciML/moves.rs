<runspec version="MOVES5.0.1">
	<description><![CDATA[County-domain (SINGLE) inventory for Washtenaw with TIME AGGREGATION by month:
<aggregateBy key="Month"/> collapses the hours (PreAggDAY.sql) and then the
day types (PreAggMONTH.sql) before any generator runs, and
<outputtimestep value="Year"/> sums the months (x weeksPerMonth). January,
April, July and October 2020 (month keys are 0-based), both day types, all 24
hours. Selections and county database as scale-county-timeagg-day
(county-inputs/washtenaw-county-timeagg/setup-timeagg.sql).]]></description>
	<models>
		<model value="ONROAD"/>
	</models>
	<modelscale value="Inv"/>
	<modeldomain value="SINGLE"/>
	<geographicselections>
		<geographicselection type="COUNTY" key="26161" description="MICHIGAN - Washtenaw County"/>
	</geographicselections>
	<timespan>
		<year key="2020"/>
		<month key="0"/>
		<month key="3"/>
		<month key="6"/>
		<month key="9"/>
		<day id="2"/>
		<day id="5"/>
		<beginhour key="0"/>
		<endhour key="23"/>
		<aggregateBy key="Month"/>
	</timespan>
	<onroadvehicleselections>
