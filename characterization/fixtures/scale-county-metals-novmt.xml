<runspec version="MOVES5.0.1">
	<description><![CDATA[County-domain (SINGLE) inventory for Washtenaw WITHOUT time
aggregation (July 2020, weekdays, hour 8; road types 1 and 4), for the gasoline
passenger car (21) and the diesel combination long-haul truck (62), selecting
the metals (60-63, 65-67) and dioxins/furans (130-146) at running exhaust with
the VMT output OFF (<outputvmtdata value="false"/>): AirToxicsDistanceCalculator
multiplies their rates by SHO.distance, which TotalActivityGenerator's TAG-9
writes only when VMT output is requested. It measures what MOVES writes then;
scale-county-minor-species is the same selection with VMT output on. County
database county-inputs/washtenaw-county-timeagg/setup-timeagg.sql.]]></description>
	<models>
		<model value="ONROAD"/>
	</models>
	<modelscale value="Inv"/>
	<modeldomain value="SINGLE"/>
	<geographicselections>
		<geographicselection type="COUNTY" key="26161" description="MICHIGAN - Washtenaw County"/>
	</geographicselections>
	<timespan>
		<year key="2020"/>
		<month key="6"/>
		<day id="5"/>
		<beginhour key="7"/>
		<endhour key="7"/>
		<aggregateBy key="Hour"/>
	</timespan>
	<onroadvehicleselections>
		<onroadvehicleselection fueltypeid="1" fueltypedesc="Gasoline" sourcetypeid="21" sourcetypename="Passenger Car"/>
		<onroadvehicleselection fueltypeid="2" fueltypedesc="Diesel Fuel" sourcetypeid="62" sourcetypename="Combination Long-haul Truck"/>
	</onroadvehicleselections>
	<offroadvehicleselections>
	</offroadvehicleselections>
	<offroadvehiclesccs>
	</offroadvehiclesccs>
